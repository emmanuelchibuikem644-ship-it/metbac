# ── Django ──────────────────────────────────────────────────────────────
# Set DEBUG=False in production (Render)
DEBUG=False
# Generate a strong random key: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-this-to-a-long-random-string
# Comma-separated list of allowed hosts. On Render, use:
#   .onrender.com,your-custom-domain.com
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
# Public URL of this API (used for absolute links in emails, etc.)
SITE_URL=https://metbac.onrender.com

# ── Render ─────────────────────────────────────────────────────────────
# Render sets RENDER=true automatically on all services. No need to set manually.
# RENDER=true

# ── Frontend (Next.js on Vercel) — used for CORS + links inside emails ──
FRONTEND_URL=https://metlinks.vercel.app
CORS_ALLOWED_ORIGINS=https://metlinks.vercel.app
CSRF_TRUSTED_ORIGINS=https://metlinks.vercel.app

# ── Seeded Django admin account (created by `manage.py create_default_admin`) ──
# CHANGE THESE before deploying anywhere real.
DEFAULT_ADMIN_EMAIL=admin@metlink.example
DEFAULT_ADMIN_PASSWORD=MetlinkAdmin!2026

# ── Database ───────────────────────────────────────────────────────────
# On Render, set DATABASE_URL to the PostgreSQL connection string provided
# by the Render PostgreSQL service (e.g. postgres://user:pass@host:5432/dbname).
# The app will automatically use PostgreSQL when DATABASE_URL is set.
DATABASE_URL=

# Fallback for local dev (SQLite by default; set DB_ENGINE=postgresql to use PostgreSQL)
DB_ENGINE=sqlite3
DB_NAME=db.sqlite3
# DB_USER=metlink
# DB_PASSWORD=metlink
# DB_HOST=localhost
# DB_PORT=5432

# ── Redis / Channels ───────────────────────────────────────────────────
# On Render, set REDIS_URL to the connection string from the Render Redis service.
REDIS_URL=redis://localhost:6379/0

# ── Email (used for verification + password reset emails) ──────────────
# In production use a real SMTP provider (SendGrid, Mailgun, etc.)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=placeholder-email-api-key
DEFAULT_FROM_EMAIL=Metlink <hello@metlink.example>

# ── Stripe (placeholders — replace with real keys before going live) ───
STRIPE_PUBLIC_KEY=pk_test_placeholder
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_PRICE_PREMIUM_MONTHLY=price_placeholder_monthly
STRIPE_PRICE_PREMIUM_YEARLY=price_placeholder_yearly

# ── PayPal (placeholders) ──────────────────────────────────────────────
PAYPAL_CLIENT_ID=placeholder-paypal-client-id
PAYPAL_CLIENT_SECRET=placeholder-paypal-client-secret
PAYPAL_MODE=sandbox

# ── Security (production) ──────────────────────────────────────────────
# Render terminates TLS at the load balancer, so this is handled automatically
# when RENDER=true. Override if needed.
# SECURE_SSL_REDIRECT=true