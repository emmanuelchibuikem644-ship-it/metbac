# Django
DEBUG=True
SECRET_KEY=change-this-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:8000

# Frontend (Next.js) — used for CORS + links inside emails
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Seeded Django admin account (created by `manage.py create_default_admin`)
# CHANGE THESE before deploying anywhere real.
DEFAULT_ADMIN_EMAIL=admin@kindred.example
DEFAULT_ADMIN_PASSWORD=KindredAdmin!2026

# Database (SQLite by default; set DB_ENGINE=postgresql to use PostgreSQL)
DB_ENGINE=sqlite3
DB_NAME=db.sqlite3
# DB_USER=kindred
# DB_PASSWORD=kindred
# DB_HOST=localhost
# DB_PORT=5432

# Redis / Channels
REDIS_URL=redis://localhost:6379/0

# Email (used for verification + password reset emails)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=placeholder-email-api-key
DEFAULT_FROM_EMAIL=Kindred <hello@kindred.example>

# Stripe (placeholders — replace with real keys before going live)
STRIPE_PUBLIC_KEY=pk_test_placeholder
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_PRICE_PREMIUM_MONTHLY=price_placeholder_monthly
STRIPE_PRICE_PREMIUM_YEARLY=price_placeholder_yearly

# PayPal (placeholders)
PAYPAL_CLIENT_ID=placeholder-paypal-client-id
PAYPAL_CLIENT_SECRET=placeholder-paypal-client-secret
PAYPAL_MODE=sandbox
